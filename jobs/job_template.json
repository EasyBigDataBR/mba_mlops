{
  "name": "MBA_MLOPS_CAUSALIMPACT_MANUAL",
  "description": "Atualização manual a partir do Drive em serverless Environment 4 (Python 3.12). Configure source_path com a URL privada da subpasta Entrada e drive_connection. Cada run valida os CSVs presentes, executa CausalImpact quando a entrada muda e confere o painel.",
  "max_concurrent_runs": 1,
  "tags": {
    "mba_mlops_demo": "causalimpact_demo_v1"
  },
  "queue": {
    "enabled": false
  },
  "performance_target": "STANDARD",
  "git_source": {
    "git_url": "https://github.com/EasyBigDataBR/mba_mlops.git",
    "git_provider": "gitHub",
    "git_branch": "main"
  },
  "environments": [
    {
      "environment_key": "causalimpact_py312",
      "spec": {
        "environment_version": "4"
      }
    }
  ],
  "parameters": [
    {
      "name": "catalog",
      "default": "mba"
    },
    {
      "name": "schema",
      "default": "mlops_causalimpact"
    },
    {
      "name": "source_mode",
      "default": "drive"
    },
    {
      "name": "source_path",
      "default": ""
    },
    {
      "name": "drive_connection",
      "default": ""
    },
    {
      "name": "as_of",
      "default": ""
    },
    {
      "name": "num_results",
      "default": "300"
    },
    {
      "name": "demo_id",
      "default": "campanha_demo_v1"
    },
    {
      "name": "max_files_per_run",
      "default": "10"
    },
    {
      "name": "experiment_path",
      "default": "/Shared/MBA_CausalImpact_Demo"
    }
  ],
  "tasks": [
    {
      "task_key": "atualizar_campanha",
      "environment_key": "causalimpact_py312",
      "description": "Executa ingestão, análise e validação com módulos Python compartilhados; interrompe o ciclo em caso de falha.",
      "notebook_task": {
        "notebook_path": "notebooks/04_Orquestrar.py",
        "source": "GIT"
      },
      "max_retries": 0,
      "retry_on_timeout": false,
      "disable_auto_optimization": true
    }
  ]
}
